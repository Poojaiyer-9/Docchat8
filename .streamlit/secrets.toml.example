# Copy this file to .streamlit/secrets.toml for a fixed deployment (e.g. on
# Streamlit Community Cloud, paste these under your app's Settings -> Secrets).
#
# This step is OPTIONAL: DocChat also lets any visitor paste their own key
# into the sidebar's "LLM Provider" section at runtime, so a shared/public
# deployment works without you putting your own key here at all.
#
# Set ONE of the following, matching the provider you want as the default.

# Groq — fast, has a free tier: https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# Anthropic (Claude): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY = "sk-ant-..."

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY = "sk-..."

# Optional: force a specific provider instead of auto-detecting from
# whichever *_API_KEY above is set. One of: groq | anthropic | openai | ollama
# LLM_PROVIDER = "groq"
