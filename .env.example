# Copy to .env and fill in ONE provider's key.
# .env is loaded automatically for local runs (see app/llm_client.py).
# When deploying on Streamlit Community Cloud, paste the same key(s) into
# the app's Settings > Secrets instead (see .streamlit/secrets.toml.example).

GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: force a specific provider instead of auto-detecting from
# whichever *_API_KEY is set above. One of: groq, anthropic, openai, ollama.
# LLM_PROVIDER=
